{
  "name": "otools-draftcalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone OTools plugin: handwritten math on draft paper, offline recognition and exact fraction evaluation.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6547",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.27",
    "mathjs": "^14",
    "onnxruntime-web": "1.22.0",
    "otools-plugin-sdk": "file:vendor/otools-plugin-sdk"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12",
    "jsdom": "26.1.0"
  }
}
